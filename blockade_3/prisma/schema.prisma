generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("TURSO_DATABASE_URL")
}

model ChatBot {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  name         String
  instructions String
  orgId        String?
}

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  originId  String
  chatId    String
  threadId  String?
  content   String
  chat      Chat     @relation(fields: [chatId], references: [id])
  origin    String

  @@index([chatId])
}

model Chat {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  deleted   Boolean
  orgId     String?
  threadId  String?
  model     String
  name      String
  messages  Message[]
}

model Waitlist {
  id        String   @id @default(cuid())
  userId    String
  userEmail String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Subscription {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String
  stripeCustomerId String
  complianceChecks Int      @default(5)

  @@index([userId])
}
